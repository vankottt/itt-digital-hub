# Local Agent Hub. Copy to platform/agent-hub/.env. Do not commit that file.
# Generate a real secret before exposing the tunnel:
#   openssl rand -hex 32
HOST=127.0.0.1
PORT=8788
ITT_HUB_SHARED_SECRET=dev-only-shared-secret-change-me
NODE_ENV=development
LOG_LEVEL=info

# Provider and lead credentials stay in this file or in the repo .env.local.
# The hub loads .env.local only for keys that are still unset. Never commit either file.
# AI_PROVIDER=google
# Gemini remains the AI Act fallback. Do not point AI_MODEL at an OpenRouter slug.
# AI_MODEL=gemini-3.8-flash
# GOOGLE_AI_API_KEY=
# GEMINI_API_KEY=
# OpenRouter is the AI Act primary. The key stays in this file on the hub machine.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=z-ai/glm-5.3-flash
# OPENROUTER_SITE_URL=https://ittdigitalhub.org
# OPENROUTER_APP_NAME=ITT Digital Hub
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=
# Optional dedicated signer for the two-question gate. Otherwise the hub secret is used.
# AI_ACT_GATE_SECRET=
