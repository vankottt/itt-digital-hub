NEXT_PUBLIC_SITE_URL=
# Opt-in only. Preview/staging stay noindex without this.
# Never set true on preview. Set only on the intended public production host
# after an explicit launch decision.
ITT_ALLOW_INDEXING=false
# Legacy alias accepted by the indexer; prefer ITT_ALLOW_INDEXING.
CIT_ALLOW_INDEXING=false

# --- Local development ---
# File-store CMS and local admin accounts (admin@itt.local / editor@itt.local).
# Env names keep the inherited CIT_* prefix. Do not set CIT_ADMIN_DEV_PASSWORD on Vercel production.
CIT_ADMIN_DEV_PASSWORD=

# HMAC keys. Production (VERCEL_ENV=production) requires CIT_ADMIN_SESSION_SECRET.
# Preview may use CIT_ADMIN_SESSION_SECRET or CIT_PREVIEW_SECRET; if unset, the
# local password may be used. Known development fallback strings are rejected
# on production and preview.
CIT_ADMIN_SESSION_SECRET=
CIT_PREVIEW_SECRET=

# --- Supabase ---
# Use the publishable/anon key in NEXT_PUBLIC_*.
# Never put the service-role key in NEXT_PUBLIC_* or client code.
# Preview and production SHOULD use separate Supabase projects when available.
# If they temporarily share a project, they MUST still use separate signing secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alias used by some Supabase SSR examples
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local people fixtures only. Never set on production.
CIT_DEV_FIXTURES=
