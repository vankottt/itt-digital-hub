{
  "name": "settlement-insight",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "tsc -b && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "db:generate": "drizzle-kit generate",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@turf/turf": "^7.2.0",
    "drizzle-orm": "0.45.2",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "lucide-react": "^0.468.0",
    "next": "^16.3.3",
    "osmtogeojson": "3.0.0-beta.5",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@eslint/js": "^9.17.0",
    "@openai/sites-vite-plugin": "^0.2.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/geojson": "^7946.0.15",
    "@types/leaflet": "^1.9.16",
    "@types/leaflet-draw": "^1.0.11",
    "@types/node": "^22.10.5",
    "@types/osmtogeojson": "^2.2.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.1",
    "vinext": "0.0.50",
    "vite": "^8.0.0",
    "vitest": "^4.1.11",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.13"
  }
}
